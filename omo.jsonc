{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "agents": {
      // hephaestus: requires an openai-family provider; kept as-is from the
      // prior migration output. Unreachable spawn paths fall back gracefully.
      "hephaestus": {
        "model": "opencode/gpt-5-nano"
      },
      // Main orchestrator: builtin chain is claude-opus-5-5 (unavailable here) -> kimi-k3
      // -> gpt-5.6-sol -> glm-5.2; kimi-k3 is the first available rung and also the top
      // rung of the framework's Recommended ladder present on Nebius. GLM-5.3 sits
      // behind kimi-k3 as fallback (the other Recommended-ladder model on Nebius;
      // Daily - Normal ranks it right after kimi-k3).
      "sisyphus": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      // High-IQ read-only consultant. Chain: gpt-5.6-sol xhigh -> gemini-3.1-pro -> claude-opus-5-5 -> glm-5.2;
      // GLM is the in-chain rung. Full GLM-5.3, not Flash: consultation needs sustained reasoning.
      // (glm-5.2 now exists on Nebius but crawls at 25 tok/s; GLM-5.3 is its current-generation
      // successor at 455 tok/s.)
      "oracle": {
        "model": "nebius/zai-org/GLM-5.3"
      },
      // Cheap/fast search lanes. Chains: kimi-for-coding-highspeed -> gpt-6-luna-fast
      // -> claude-haiku-5-5 -> deepseek-flash -> qwen3.7-plus -> minimax-m2.7.
      // The deepseek-flash rung has served V4.1 since 2026-09-10, so the current-gen
      // snapshot is the in-chain pick; GLM-5.3-Flash is the cheap second rung.
      // "Search needs speed, not intelligence."
      "librarian": {
        "models": [
          "nebius/deepseek-ai/DeepSeek-V4.1-Flash-1017",
          "nebius/zai-org/GLM-5.3-Flash"
        ]
      },
      "explore": {
        "models": [
          "nebius/deepseek-ai/DeepSeek-V4.1-Flash-1017",
          "nebius/zai-org/GLM-5.3-Flash"
        ]
      },
      // Image/PDF/video summarizer. Chain: gpt-5.6-sol low -> kimi-k3 -> glm-4.6v -> gpt-5-nano.
      // Muse Spark Open leads on visual benchmarks (ZeroBench 50 vs kimi 41) and is the
      // only roster model taking video/audio; pinned at low reasoning to keep its always-on
      // thinking from stalling simple descriptions (off-ladder, unvalidated prompt preset).
      // kimi-k3 is the ladder-validated second rung. No GLM rung here: both GLM-5.3 and
      // GLM-5.3-Flash serve text-only on this token factory.
      "multimodal-looker": {
        "models": [
          {
            "model": "nebius/meta-models/muse-spark-open",
            "reasoning": "low"
          },
          "nebius/moonshotai/Kimi-K3"
        ]
      },
      // Planner and pre-planning consultant. Chains: claude-fable-5-1 (unavailable)
      // -> claude-opus-5-5 -> kimi-k3 max. GLM-5.3 sits behind kimi-k3 as fallback.
      "prometheus": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      "metis": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      // Plan reviewer needs sustained reasoning (Flash/small models drift and rubber-stamp).
      // Chain: gpt-6-astra xhigh -> claude-opus-5-5 -> gemini-3.1-pro -> glm-5.2;
      // GLM-5.3 is the full-model analog.
      "momus": {
        "model": "nebius/zai-org/GLM-5.3"
      },
      // Executor workers. Chain: claude-sonnet-5 (unavailable) -> kimi-k3 -> gpt-5.6-sol medium -> minimax;
      // kimi-k3 is the first available rung and serves as the sonnet-5-class executor.
      // GLM-5.3 sits behind kimi-k3 as fallback.
      "atlas": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      "sisyphus-junior": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      }
    },
    "categories": {
      // visual-engineering/artistry chains: fable-5-1 -> opus-5-5 -> kimi-k3 (first available rung).
      // writing chain is Claude-only (opus-5-5 -> opus-4-6); kimi-k3 is the Claude-mirroring
      // substitute per the model guide. GLM-5.3 sits behind kimi-k3 as fallback.
      "visual-engineering": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      "artistry": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      "writing": {
        "models": [
          "nebius/moonshotai/Kimi-K3",
          "nebius/zai-org/GLM-5.3"
        ]
      },
      // GPT-shaped autonomous lane gated on astra-class reasoning (gpt-6-astra/gpt-5.6-sol;
      // none on Nebius, and gpt-oss-120b is too small for the gate). The guide marks
      // ultrabrain on Claude or Kimi as risky, so the astra-class analog is GLM-5.3 — a
      // Recommended-ladder rung that the sibling unspecified-high chain ranks ahead of
      // kimi-k3 for this shape. Full model, not Flash: sustained reasoning.
      "ultrabrain": {
        "model": "nebius/zai-org/GLM-5.3"
      },
      // GPT-shaped mid-tier reasoning lane. deep-low chain: gpt-6.1-sol medium -> ...
      // (no GPT-6 on Nebius). The only OpenAI-family rung, gpt-oss-120b, serves at 40 tok/s —
      // speed is a constraint on this default deep lane, so it takes GLM-5.3 (455 tok/s,
      // 1M ctx): the same Claude-like Recommended-ladder reasoner the sibling reasoning
      // lanes use.
      "deep-low": {
        "model": "nebius/zai-org/GLM-5.3"
      },
      // Escalation deep lane for decisions that cannot be settled from evidence alone.
      // deep-high chain: gpt-6-astra high (no fallback rungs). The guide marks deep-high on
      // Claude or Kimi as risky; GLM-5.3 is the astra-class reasoner among available models
      // (Recommended-ladder rung, 750B, 455 tok/s).
      "deep-high": {
        "model": "nebius/zai-org/GLM-5.3"
      },
      // Chain: claude-opus-5-5 -> glm-5.3 max -> kimi-k3 max; glm-5.3 is the first available rung.
      "unspecified-high": {
        "model": "nebius/zai-org/GLM-5.3"
      },
      // Trivial tasks. Quick chain: gpt-6-luna-fast -> claude-haiku-5-5 -> deepseek-flash
      // -> qwen3.6-flash -> ... -> glm-5.3-flash; both flash rungs resolve on Nebius,
      // deepseek first (cheapest, 0731 base costs $0.14/$0.28), glm as backup.
      "quick": {
        "models": [
          "nebius/deepseek-ai/DeepSeek-V4.1-Flash-1017",
          "nebius/zai-org/GLM-5.3-Flash"
        ]
      },
      // Catch-all low-effort worker. Chain: sonnet-5-5 -> mimo-v2.6-pro -> grok-4.7
      // -> gpt-6.1/5.6-sol -> sonnet-5 -> qwen3.8-max-preview -> deepseek-v4-pro @max -> mimo-v2.5-pro;
      // the in-chain deepseek-v4-pro rung serves at 24-37 tok/s — too slow for a worker lane.
      // Kimi-K2.7-Code is the sonnet-5-class code executor (agentic coding specialist,
      // 231 tok/s, image input): a reasonable fast worker.
      "unspecified-low": {
        "model": "nebius/moonshotai/Kimi-K2.7-Code"
      }
    },
    // Team Mode: parallel multi-agent coordination
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 8,
      "max_members": 8,
      // Team definitions + runtime state live under <base_dir>/teams/.
      "base_dir": "/home/omo/project/.omo"
    },
    // User-layer-only key: walked project layers cannot set playwright_mcp_args.
    "browser_automation_engine": {
      // Container has no display server: force headless Chromium with sandbox disabled.
      // Chromium is provided by the Dockerfile (PLAYWRIGHT_BROWSERS_PATH=/ms-playwright).
      "playwright_mcp_args": [
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox"
      ]
    }
  }
}
