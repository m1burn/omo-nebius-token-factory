{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "agents": {
      // Policy: entries with no applicable OMO variant use the user's local
      // default of medium reasoning. That is a local default, not an inferred
      // OMO recommendation.
      // No hephaestus override: the agent requires an OpenAI-family model
      // (gpt-6-sol / gpt-5.6-sol). Neither the prior opencode/gpt-5-nano pin nor
      // the token factory's gpt-oss-120b passes OMO's support predicate, so the
      // override is removed and normal OMO defaults apply.
      // Main orchestrator. Chain: claude-opus-5-5 max -> kimi-k3.1-pro -> kimi-k3
      // -> gpt-5.6-sol medium -> glm-5.2 -> big-pickle. The kimi and kimi-k3
      // rungs resolve on this token factory as Kimi-K3.1-Pro and Kimi-K3;
      // GLM-5.3 stands in for the glm-5.2 rung as the current-generation GLM.
      "sisyphus": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "medium"
          },
          {
            "model": "nebius/moonshotai/Kimi-K3",
            "reasoning": "medium"
          },
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      // High-IQ read-only consultant. Chain: gpt-5.6-sol xhigh -> gemini-4-argon
      // high -> claude-opus-5-5 max -> glm-5.2. GLM-5.3 stands in for the glm-5.2
      // rung as the current-generation GLM. Full model, not Flash: consultation
      // needs sustained reasoning.
      "oracle": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      // Cheap/fast search lanes. Chain: kimi-for-coding-highspeed -> gpt-luna-fast
      // -> claude-haiku-5-5 -> deepseek-flash -> qwen3.7-plus -> minimax-m2.7.
      // The deepseek-flash rung resolves to the current DeepSeek-V4.1-Flash-1017
      // snapshot; the minimax rung resolves to MiniMax-M3 (minimax-m2.7 is not
      // served here). "Search needs speed, not intelligence."
      "librarian": {
        "models": [
          {
            "model": "nebius/deepseek-ai/DeepSeek-V4.1-Flash-1017",
            "reasoning": "max"
          },
          {
            "model": "nebius/MiniMaxAI/MiniMax-M3",
            "reasoning": "medium"
          }
        ]
      },
      "explore": {
        "models": [
          {
            "model": "nebius/deepseek-ai/DeepSeek-V4.1-Flash-1017",
            "reasoning": "max"
          },
          {
            "model": "nebius/MiniMaxAI/MiniMax-M3",
            "reasoning": "medium"
          }
        ]
      },
      // Image/PDF summarizer. Chain: gpt-5.6-sol low -> kimi-k3.1-pro -> glm-4.6v
      // -> gpt-5-nano. Kimi-K3.1-Pro is the first in-chain rung served here
      // (text+image input). Muse-Spark-Open is an off-chain fallback: not part
      // of OMO's chain, picked locally for its image input; pinned at low
      // reasoning to keep its always-on thinking from stalling simple
      // descriptions. No GLM rung: GLM-5.3 and GLM-5.3-Flash serve text-only on
      // this token factory.
      "multimodal-looker": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "medium"
          },
          {
            "model": "nebius/meta-models/muse-spark-open",
            "reasoning": "low"
          }
        ]
      },
      // Planner and pre-planning consultant. Chain: claude-fable-5-2 xhigh
      // -> claude-fable-5-1 -> claude-opus-5-5 max -> kimi-k3.1-pro max
      // -> kimi-k3 max. Kimi-K3.1-Pro and Kimi-K3 are the in-chain rungs served
      // here; GLM-5.3 sits behind them as a local fallback.
      "prometheus": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "max"
          },
          {
            "model": "nebius/moonshotai/Kimi-K3",
            "reasoning": "max"
          },
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      "metis": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "max"
          },
          {
            "model": "nebius/moonshotai/Kimi-K3",
            "reasoning": "max"
          },
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      // Plan reviewer needs sustained reasoning (Flash/small models drift and
      // rubber-stamp). Chain: gpt-6.2-astra xhigh -> claude-opus-5-5 max
      // -> gemini-4-argon high -> glm-5.2. GLM-5.3 stands in for the glm-5.2
      // rung as the current-generation GLM.
      "momus": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      // Executor workers. Chain: claude-sonnet-5 -> kimi-k3.1-pro -> gpt-5.6-sol
      // medium -> minimax-m3 -> MiniMax-M3 -> minimax-m2.7. Kimi-K3.1-Pro is
      // the first available rung; MiniMax-M3 is the in-chain minimax rung
      // served here.
      "atlas": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "medium"
          },
          {
            "model": "nebius/MiniMaxAI/MiniMax-M3",
            "reasoning": "medium"
          }
        ]
      },
      "sisyphus-junior": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "medium"
          },
          {
            "model": "nebius/MiniMaxAI/MiniMax-M3",
            "reasoning": "medium"
          }
        ]
      }
    },
    "categories": {
      // visual-engineering/artistry chains: gemini-4-argon low -> claude-fable-5-2
      // max -> claude-fable-5-1 -> claude-opus-5-5 max -> kimi-k3.1-pro max
      // -> kimi-k3 max. Kimi-K3.1-Pro and Kimi-K3 are the in-chain rungs served
      // here.
      "visual-engineering": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "max"
          },
          {
            "model": "nebius/moonshotai/Kimi-K3",
            "reasoning": "max"
          }
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "max"
          },
          {
            "model": "nebius/moonshotai/Kimi-K3",
            "reasoning": "max"
          }
        ]
      },
      // Writing chain is Argon/Claude-only (gemini-4-argon low -> claude-opus-5-5
      // low -> claude-opus-4-6 max) and OMO leaves the lane unavailable when
      // none of its rungs resolve. Argon and Claude are unavailable here, so
      // this is an explicit best-effort cross-family override: Kimi-K3.1-Pro
      // with GLM-5.3 behind it. Not an OMO-sanctioned fallback. The medium
      // levels are the user's local default, not an Argon/Claude-derived level.
      "writing": {
        "models": [
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "medium"
          },
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      // GPT-shaped autonomous lane. OMO's chain is a single gpt-6.2-astra max
      // rung with no fallback; that model is unavailable on this token factory,
      // so GLM-5.3 stands in as the best-effort available reasoner, not a
      // source-backed equivalent. Its max level is inherited from the
      // unavailable GPT lane's recommendation, not an exact OMO GLM fallback
      // variant. Full model, not Flash: sustained reasoning.
      "ultrabrain": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "max"
          }
        ]
      },
      // GPT-shaped mid-tier reasoning lane. OMO's chain is a single gpt-6.2-sol
      // medium rung with no fallback; no GPT-6 is served here, so GLM-5.3
      // stands in as the best-effort available reasoner, not a source-backed
      // equivalent. Its medium level is inherited from the unavailable GPT
      // lane's recommendation, not an exact OMO GLM fallback variant.
      "deep-low": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "medium"
          }
        ]
      },
      // Escalation deep lane for decisions that cannot be settled from evidence
      // alone. OMO's chain is a single gpt-6.2-astra high rung with no fallback;
      // it is unavailable here, so GLM-5.3 stands in as the best-effort
      // available reasoner, not a source-backed equivalent. Its high level is
      // inherited from the unavailable GPT lane's recommendation, not an exact
      // OMO GLM fallback variant.
      "deep-high": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "high"
          }
        ]
      },
      // Chain: claude-opus-5-5 medium -> glm-5.3 max -> kimi-k3.1-pro max
      // -> kimi-k3 max. GLM-5.3 is the first available rung; Kimi-K3.1-Pro
      // sits behind it.
      "unspecified-high": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "max"
          },
          {
            "model": "nebius/moonshotai/Kimi-K3.1-Pro",
            "reasoning": "max"
          }
        ]
      },
      // Trivial tasks. Quick chain: gpt-luna-fast -> claude-haiku-5-5
      // -> deepseek-flash -> qwen3.6-flash -> minimax-m3 -> ... -> glm-5.3-flash.
      // The in-chain rungs served here: DeepSeek-V4.1-Flash-1017
      // (deepseek-flash), MiniMax-M3 (minimax-m3), then GLM-5.3-Flash
      // (glm-5.3-flash).
      "quick": {
        "models": [
          {
            "model": "nebius/deepseek-ai/DeepSeek-V4.1-Flash-1017",
            "reasoning": "off"
          },
          {
            "model": "nebius/MiniMaxAI/MiniMax-M3",
            "reasoning": "max"
          },
          {
            "model": "nebius/zai-org/GLM-5.3-Flash",
            "reasoning": "low"
          }
        ]
      },
      // Catch-all low-effort worker. Chain: claude-sonnet-5-5 -> mimo-v2.6-pro
      // -> grok-4.7 -> glm-5.3 high -> gpt-6.2-sol -> ... The glm rung is the
      // first in-chain rung served here, so GLM-5.3 takes the lane.
      "unspecified-low": {
        "models": [
          {
            "model": "nebius/zai-org/GLM-5.3",
            "reasoning": "high"
          }
        ]
      }
    },
    // Team Mode: parallel multi-agent coordination
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 8,
      "max_members": 8,
      // Team definitions + runtime state live under <base_dir>/teams/.
      "base_dir": "/home/omo/project/.omo"
    },
    // User-layer-only key: walked project layers cannot set playwright_mcp_args.
    "browser_automation_engine": {
      // Container has no display server: force headless Chromium with sandbox disabled.
      // Chromium is provided by the Dockerfile (PLAYWRIGHT_BROWSERS_PATH=/ms-playwright).
      "playwright_mcp_args": [
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox"
      ]
    }
  }
}
