{
  "agents": {
    "sisyphus": { "model": "nebius/moonshotai/Kimi-K2.7-Code", "ultrawork": { "model": "nebius/moonshotai/Kimi-K2.7-Code" } },
    "oracle": { "model": "nebius/zai-org/GLM-5.3-Flash" },
    "librarian": { "model": "nebius/MiniMaxAI/MiniMax-M3" },
    "explore": { "model": "nebius/MiniMaxAI/MiniMax-M3" },
    "multimodal-looker": { "model": "nebius/moonshotai/Kimi-K2.7-Code" },
    "prometheus": { "model": "nebius/moonshotai/Kimi-K3" },
    "metis": { "model": "nebius/moonshotai/Kimi-K3" },
    "momus": { "model": "nebius/zai-org/GLM-5.3-Flash" },
    "atlas": { "model": "nebius/moonshotai/Kimi-K2.7-Code" },
    "sisyphus-junior": { "model": "nebius/moonshotai/Kimi-K2.7-Code" },
  },
  "categories": {
    "visual-engineering": { "model": "nebius/moonshotai/Kimi-K3" },
    "ultrabrain": { "model": "nebius/zai-org/GLM-5.3-Flash" },
    "deep": { "model": "nebius/zai-org/GLM-5.3-Flash" },
    "artistry": { "model": "nebius/moonshotai/Kimi-K3" },
    "quick": { "model": "nebius/MiniMaxAI/MiniMax-M3" },
    "unspecified-low": { "model": "nebius/moonshotai/Kimi-K2.7-Code" },
    "unspecified-high": { "model": "nebius/moonshotai/Kimi-K3" },
    "writing": { "model": "nebius/MiniMaxAI/MiniMax-M3" },
  },
  "browser_automation_engine": {
    // Container has no display server: force headless Chromium with sandbox disabled.
    // Chromium is provided by the Dockerfile (PLAYWRIGHT_BROWSERS_PATH=/ms-playwright).
    "playwright_mcp_args": ["--headless", "--browser", "chromium", "--no-sandbox"],
  },
}